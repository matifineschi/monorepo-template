{
	"name": "@repo/auth",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"gen:schema": "SKIP_ENV_VALIDATION=1 bun x auth@latest generate --output ../db/src/schema/user-auth.ts && ./patch-schema.sh"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"exports": {
		".": {
			"types": "./src/auth.ts",
			"import": "./src/auth.ts",
			"default": "./src/auth.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"import": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./env": {
			"types": "./src/env.ts",
			"import": "./src/env.ts",
			"default": "./src/env.ts"
		}
	},
	"dependencies": {
		"@repo/db": "workspace:*",
		"@repo/env": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"better-auth": "^1.7.22",
		"zod": "catalog:"
	}
}
