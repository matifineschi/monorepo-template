# Copy to .env and fill in. Every app owns its own file — there is no root .env.
#
# apps/cron is a set of one-shot jobs, run by the platform's cron:
#   bun run dist/main.js <postgres-backup|postgres-restore-check|bucket-backup|bucket-backup-check>
# Locally: bun run --filter cron job <name>

# Postgres — owned by @repo/db. Read access, plus CREATEDB on the server the
# restore check restores into.
DATABASE_URL=postgres://postgres:postgres@localhost:5430/postgres
DATABASE_APP_NAME=cron

# Backup bucket — a different account/provider from the database. Versioning
# on, and a lifecycle rule that expires noncurrent versions after 90 days
# (docs/backups.md). Write-limited credentials: PutObject + ListBucket + GetObject.
BACKUP_S3_ENDPOINT=http://localhost:9000
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=app-backups
BACKUP_S3_ACCESS_KEY_ID=minioadmin
BACKUP_S3_SECRET_ACCESS_KEY=minioadmin
BACKUP_S3_FORCE_PATH_STYLE=true

# The application's bucket, as the source of bucket-backup. READ-ONLY credentials.
SOURCE_S3_ENDPOINT=http://localhost:9000
SOURCE_S3_REGION=auto
SOURCE_S3_BUCKET=app-uploads
SOURCE_S3_ACCESS_KEY_ID=minioadmin
SOURCE_S3_SECRET_ACCESS_KEY=minioadmin
SOURCE_S3_FORCE_PATH_STYLE=true

# postgres-backup / postgres-restore-check
POSTGRES_BACKUP_PREFIX=postgres
# Separate server to restore into. Unset = the production server, which puts
# the restore's load on production; set it once the database is non-trivial.
# RESTORE_CHECK_DATABASE_URL=

# bucket-backup / bucket-backup-check
BUCKET_BACKUP_PREFIX=files
# A run that hits this resumes next time.
BUCKET_BACKUP_MAX_DURATION=1h
BUCKET_BACKUP_TRANSFERS=8
BUCKET_BACKUP_CHECK_SAMPLE_SIZE=10

# Scratch space for dumps. Needs room for one full dump.
# WORK_DIR=/tmp

# Dead-man's switch, one per job. Pinged at <url>/start, <url> on success and
# <url>/fail (healthchecks.io / Better Stack style). Alert when the success
# ping does not arrive — the only way to notice a job that never ran.
# POSTGRES_BACKUP_HEARTBEAT_URL=
# POSTGRES_RESTORE_CHECK_HEARTBEAT_URL=
# BUCKET_BACKUP_HEARTBEAT_URL=
# BUCKET_BACKUP_CHECK_HEARTBEAT_URL=

# Logging — owned by @repo/logger.
LOG_LEVEL=info
