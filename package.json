{
	"name": "my-turborepo",
	"private": true,
	"catalog": {
		"next": "16.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "5.9.2",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@biomejs/biome": "2.3.8",
		"turbo": "^2.9.5",
		"@turbo/gen": "^2.9.5",
		"@t3-oss/env-core": "^0.13.10",
		"@t3-oss/env-nextjs": "^0.13.10",
		"zod": "^4.3.6",
		"@aws-sdk/client-s3": "^3.980.0",
		"@aws-sdk/s3-request-presigner": "^3.980.0",
		"@astryxdesign/core": "0.7.14",
		"@astryxdesign/theme-neutral": "0.7.14",
		"@astryxdesign/cli": "0.7.14",
		"@stylexjs/stylex": "^0.19.2"
	},
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"dev": "turbo run dev --parallel",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration --concurrency=1",
		"ci": "biome check . && turbo run typecheck test",
		"ci:full": "bun run ci && bun run knip && turbo run build && bun run db:wait && bun run --filter @repo/db db:migrate && bun run test:integration",
		"gen:package": "turbo gen package",
		"astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
		"knip": "knip",
		"db:up": "docker compose up -d",
		"db:wait": "docker compose up -d --wait postgres redis minio && docker compose up -d minio-createbucket",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"prepare": "husky"
	},
	"devDependencies": {
		"@astryxdesign/cli": "catalog:",
		"@biomejs/biome": "catalog:",
		"@turbo/gen": "catalog:",
		"@types/node": "catalog:",
		"bun-types": "^1.3.13",
		"husky": "^9.1.7",
		"knip": "^6.3.1",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=20.9.0"
	},
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/infra/*"
	]
}
