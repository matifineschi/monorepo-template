import { shouldSkipEnvValidation } from "@repo/env";
import { createEnv } from "@t3-oss/env-core";
import { z } from "zod";

/**
 * This package owns these variables. Apps compose them with
 * `extends: [{{ camelName }}Env]` in their own `env.ts`, and every consuming
 * app's `.env.example` must list them.
 */
export const {{ camelName }}Env = createEnv({
	emptyStringAsUndefined: true,
	runtimeEnv: process.env,
	server: {
		// EXAMPLE_URL: z.url(),
	},
	skipValidation: shouldSkipEnvValidation(),
});
