{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"ignoreUnresolved": ["next"],
	"workspaces": {
		".": {
			"entry": ["turbo/generators/config.ts"]
		},
		"apps/web": {
			"entry": ["env.ts"]
		},
		"apps/api": {
			"entry": [
				"src/index.ts",
				"tests/integration/*.test.ts",
				"test-setup.integration.ts"
			]
		},
		"apps/workers": {
			"entry": [
				"src/index.ts",
				"tests/integration/*.test.ts",
				"test-setup.integration.ts"
			]
		},
		"packages/queues": {
			"entry": ["tests/integration/*.test.ts", "test-setup.integration.ts"]
		},
		"packages/ui": {},
		"packages/infra/db": {
			"entry": [
				"src/operations/*.ts",
				"src/testing/*.ts",
				"tests/integration/*.test.ts",
				"test-setup.integration.ts"
			]
		},
		"packages/infra/storage": {
			"entry": [
				"src/testing/*.ts",
				"tests/integration/*.test.ts",
				"test-setup.integration.ts"
			]
		},
		"packages/utils": {},
		"packages/logger": {}
	}
}
