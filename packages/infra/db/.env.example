# Read only by drizzle-kit (db:generate / db:migrate / db:push), which runs with
# this package as its cwd. The apps get DATABASE_URL from their own .env files.
# Port 5430 (not 5432) is the host mapping in docker-compose.yml, chosen to avoid
# clashing with a locally-installed Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5430/postgres
