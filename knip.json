{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"workspaces": {
		".": {},
		"apps/web": {
			"entry": ["env.ts"]
		},
		"apps/api": {
			"entry": ["tests/integration/*.test.ts"]
		},
		"apps/workers": {
			"entry": ["tests/integration/*.test.ts"]
		},
		"packages/queues": {
			"entry": ["tests/integration/*.test.ts"]
		},
		"packages/ui": {},
		"packages/infra/db": {
			"entry": [
				"src/operations/*.ts",
				"src/testing/*.ts",
				"tests/integration/*.test.ts"
			]
		},
		"packages/infra/storage": {
			"entry": ["src/testing/*.ts", "tests/integration/*.test.ts"]
		},
		"packages/utils": {},
		"packages/logger": {},
		"apps/cron": {
			"entry": ["tests/integration/*.test.ts"]
		}
	}
}
