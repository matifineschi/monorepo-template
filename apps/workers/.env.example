# Copy to .env and fill in. Every app owns its own file — there is no root .env.

# Redis — owned by @repo/queues (queuesEnv). Must match docker-compose.yml, and
# must be the same instance apps/api enqueues to.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage — owned by @repo/storage (storageEnv).
# Defaults target the MinIO in docker-compose (console: http://localhost:9001,
# minioadmin / minioadmin).
# MUST match apps/api/.env — the API presigns uploads into the same bucket this
# app deletes from.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=app-uploads
STORAGE_FORCE_PATH_STYLE=true

# Owned by this app. BullMQ jobs processed in parallel per worker.
# Defaults to 5 if unset.
WORKER_CONCURRENCY=5

# Logging — owned by @repo/logger. silent | debug | info | warn | error.
# Defaults to info. `silent` is for test runs, not for a deployed environment.
LOG_LEVEL=info

# No DATABASE_URL: neither worker touches Postgres. If you add one that does,
# extend databaseEnv in src/env.ts and add the variable here in the same commit.
