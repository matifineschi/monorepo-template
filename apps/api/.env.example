# Copy to .env and fill in. Every app owns its own file — there is no root .env,
# because each app runs with its own workspace as cwd and only reads from there.

# Postgres — owned by @repo/db (databaseEnv). Must match docker-compose.yml,
# which maps the container's 5432 to host port 5430 to avoid clashing with a
# locally-installed Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5430/postgres

# better-auth — owned by @repo/auth (authEnv). BETTER_AUTH_URL is the origin
# that *issues* the session cookie, i.e. the web app, not this API.
# MUST be the same value in apps/api/.env and apps/web/.env, or sessions minted
# by one will not validate in the other.
BETTER_AUTH_URL=http://localhost:3000
# Server-only. Generate with: openssl rand -base64 32
# MUST be the same value in apps/api/.env and apps/web/.env.
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Redis — owned by @repo/queues (queuesEnv). This app enqueues file-cleanup
# jobs; apps/workers consumes them, so both point at the same instance.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage — owned by @repo/storage (storageEnv).
# Defaults target the MinIO in docker-compose (console: http://localhost:9001,
# minioadmin / minioadmin). In production point these at your real bucket and
# set STORAGE_FORCE_PATH_STYLE=false for AWS S3.
# MUST match apps/workers/.env — both address the same bucket.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=app-uploads
STORAGE_FORCE_PATH_STYLE=true

# Owned by this app. Browser origin allowed to send credentialed requests here.
# No default on purpose, so a production deploy can't silently ship a dev policy.
CORS_ORIGIN=http://localhost:3000
# Owned by this app. Defaults to 3001 if unset.
PORT=3001

# Logging — owned by @repo/logger. silent | debug | info | warn | error.
# Defaults to info. `silent` is for test runs, not for a deployed environment.
LOG_LEVEL=info
