# Copy to .env and fill in. Every app owns its own file — there is no root .env.

# Redis — owned by @repo/queues (queuesEnv). Must match docker-compose.yml, and
# must be the same instance apps/api enqueues to.
REDIS_URL=redis://localhost:6379

# Namespaces every BullMQ key in Redis — owned by @repo/queues. Defaults to
# `bull`, which is what a deployed environment should stay on: changing it
# orphans every job already enqueued. Integration tests set their own.
# QUEUE_PREFIX=bull

# S3-compatible object storage — owned by @repo/storage (storageEnv).
# Defaults target the MinIO in docker-compose (console: http://localhost:9001,
# minioadmin / minioadmin).
# MUST match apps/api/.env — the API presigns uploads into the same bucket this
# app deletes from.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=app-uploads
STORAGE_FORCE_PATH_STYLE=true

# Email — owned by @repo/email (emailEnv).
# `log` (the default) renders each email and writes it to the log instead of
# sending it, so local dev needs no Resend account. Set `resend` to send.
EMAIL_TRANSPORT=log
# A Resend *sending-access* key (https://resend.com/api-keys), restricted to
# your sending domain once it is verified. Required when EMAIL_TRANSPORT=resend.
# Never commit a real key; never use a full-access key in an app.
RESEND_API_KEY=
# The sender. `onboarding@resend.dev` works before your domain is verified, but
# only delivers to the Resend account owner's own address. In production use
# your verified domain, e.g. "Acme <hello@mail.example.com>".
# MUST be the same in apps/web, apps/api and apps/workers.
EMAIL_FROM="Acme <onboarding@resend.dev>"

# Owned by this app. BullMQ jobs processed in parallel per worker.
# Defaults to 5 if unset.
WORKER_CONCURRENCY=5

# Logging — owned by @repo/logger. silent | debug | info | warn | error.
# Defaults to info. `silent` is for test runs, not for a deployed environment.
LOG_LEVEL=info

# No DATABASE_URL: neither worker touches Postgres. If you add one that does,
# extend databaseEnv in src/env.ts and add the variable here in the same commit.
