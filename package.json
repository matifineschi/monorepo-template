{
	"name": "my-turborepo",
	"private": true,
	"catalog": {
		"next": "16.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "7.0.2",
		"@types/node": "^26.6.6",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@biomejs/biome": "2.6.7",
		"turbo": "^2.11.11",
		"@turbo/gen": "^2.11.11",
		"@t3-oss/env-core": "^0.13.10",
		"@t3-oss/env-nextjs": "^0.13.10",
		"zod": "^4.3.6",
		"@aws-sdk/client-s3": "^3.980.0",
		"@aws-sdk/s3-request-presigner": "^3.980.0",
		"@astryxdesign/core": "0.7.14",
		"@astryxdesign/theme-neutral": "0.7.14",
		"@astryxdesign/cli": "0.7.14",
		"@stylexjs/stylex": "^0.19.2",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3"
	},
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"dev": "turbo run dev --parallel",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"lint:ws": "sherif --ignore-rule packages-without-package-json",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration",
		"ci": "biome check . && bun run lint:ws && turbo run typecheck test",
		"ci:full": "bun run ci && bun run knip && turbo run build && bun run test-infra:up && bun run test:integration",
		"gen:package": "turbo gen package",
		"astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
		"knip": "knip",
		"db:up": "docker compose up -d",
		"db:wait": "docker compose up -d --wait postgres redis minio && docker compose up -d minio-createbucket",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"test-infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"test-infra:down": "docker compose -f docker-compose.test.yml down -v",
		"test-infra:logs": "docker compose -f docker-compose.test.yml logs --tail 200",
		"prepare": "husky"
	},
	"devDependencies": {
		"@astryxdesign/cli": "catalog:",
		"@biomejs/biome": "catalog:",
		"@turbo/gen": "catalog:",
		"@types/node": "catalog:",
		"bun-types": "^1.4.4",
		"husky": "^9.1.7",
		"knip": "^6.45.1",
		"sherif": "^1.13.0",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=20.9.0"
	},
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/infra/*"
	]
}
