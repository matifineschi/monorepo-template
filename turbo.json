{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV", "SKIP_ENV_VALIDATION"],
	"globalDependencies": ["**/.env.example"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": [
				"NEXT_PUBLIC_*",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CORS_ORIGIN",
				"DATABASE_*",
				"LOG_LEVEL",
				"PORT",
				"QUEUE_PREFIX",
				"REDIS_URL",
				"STORAGE_*"
			]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": [],
			"outputs": []
		},
		"test:integration": {
			"cache": false,
			"passThroughEnv": [
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_*",
				"QUEUE_PREFIX",
				"REDIS_URL",
				"STORAGE_*"
			]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
