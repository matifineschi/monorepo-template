# Copy to .env and fill in. Every app owns its own file — there is no root .env.

# Postgres — owned by @repo/db (databaseEnv). Reached through @repo/auth's
# Drizzle adapter from server actions and route handlers.
DATABASE_URL=postgres://postgres:postgres@localhost:5430/postgres

# Connection pool, owned by @repo/db. All optional — the defaults below are what
# the package applies when they are unset. DATABASE_POOL_MAX is per process, so
# multiply it by the number of processes before comparing it to Postgres'
# max_connections. DATABASE_APP_NAME tags connections in pg_stat_activity.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=20
# DATABASE_CONNECT_TIMEOUT=30
DATABASE_APP_NAME=web

# better-auth — owned by @repo/auth (authEnv).
# MUST be the same values as apps/api/.env, or sessions won't cross services.
BETTER_AUTH_URL=http://localhost:3000
# Server-only, never exposed to the browser. openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Public — inlined into the client bundle at build time by Next, so changing it
# requires a rebuild, not just a restart. Used for metadataBase (canonical URLs,
# Open Graph). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# No STORAGE_* here on purpose: the browser uploads straight to a presigned URL
# it gets from the API, so the web server never holds bucket credentials.
