{
	"name": "@repo/db",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"test:integration": "bun test --preload ./test-setup.integration.ts tests/integration",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"db:push": "drizzle-kit push"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"drizzle-kit": "^0.31.5",
		"typescript": "catalog:"
	},
	"exports": {
		"./env": {
			"types": "./src/env.ts",
			"import": "./src/env.ts",
			"default": "./src/env.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"import": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./operations/users": {
			"types": "./src/operations/users.ts",
			"import": "./src/operations/users.ts",
			"default": "./src/operations/users.ts"
		},
		"./operations/user-auth": {
			"types": "./src/operations/user-auth.ts",
			"import": "./src/operations/user-auth.ts",
			"default": "./src/operations/user-auth.ts"
		},
		"./errors": {
			"types": "./src/errors.ts",
			"import": "./src/errors.ts",
			"default": "./src/errors.ts"
		},
		"./transaction": {
			"types": "./src/transaction.ts",
			"import": "./src/transaction.ts",
			"default": "./src/transaction.ts"
		},
		"./testing/database": {
			"types": "./src/testing/database.ts",
			"import": "./src/testing/database.ts",
			"default": "./src/testing/database.ts"
		}
	},
	"dependencies": {
		"@repo/env": "workspace:*",
		"@repo/utils": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"zod": "catalog:"
	}
}
